{
  "info": {
    "name": "SIGR - API REST",
    "description": "Pruebas automatizadas de la API del Sistema Integral de Gestión de Restaurante.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Responde en menos de 1 segundo\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login correcto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"clave\": \"Admin2026*\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Devuelve el rol ADMINISTRADOR\", () => pm.expect(b.rol).to.eql(\"ADMINISTRADOR\"));",
                  "pm.test(\"No expone la clave en la respuesta\", () => pm.expect(b).to.not.have.property(\"clave\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con clave incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"clave\": \"equivocada\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mensaje de error claro\", () => pm.expect(pm.response.json().errores).to.include(\"Usuario o clave incorrectos\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Menú",
      "item": [
        {
          "name": "Listar platos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/platos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "platos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "const platos = pm.response.json();",
                  "pm.test(\"Hay al menos 5 platos\", () => pm.expect(platos.length).to.be.at.least(5));",
                  "pm.test(\"Cada plato tiene nombre y precio mayor a cero\", () => platos.forEach(p => { pm.expect(p.nombre).to.be.a(\"string\").and.not.empty; pm.expect(p.precio).to.be.above(0); }));",
                  "const bandeja = platos.find(p => p.nombre === \"Bandeja paisa\");",
                  "const limonada = platos.find(p => p.nombre === \"Limonada de coco\");",
                  "pm.collectionVariables.set(\"bandejaId\", bandeja.id); pm.collectionVariables.set(\"limonadaId\", limonada.id);",
                  "pm.collectionVariables.set(\"totalEsperado\", bandeja.precio * 2 + limonada.precio * 2);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear plato con datos inválidos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/platos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "platos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"precio\": 500\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Informa los tres errores de validación\", () => pm.expect(pm.response.json().errores).to.have.lengthOf(3));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Pedidos",
      "item": [
        {
          "name": "Crear pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesa\": 4,\n  \"platos\": {\n    \"{{bandejaId}}\": 2,\n    \"{{limonadaId}}\": 2\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test(\"Queda en estado RECIBIDO\", () => pm.expect(p.estado).to.eql(\"RECIBIDO\"));",
                  "pm.test(\"El total coincide con los precios del menú\", () => pm.expect(p.total).to.eql(Number(pm.collectionVariables.get(\"totalEsperado\"))));",
                  "pm.collectionVariables.set(\"pedidoId\", p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Avanzar a EN_PREPARACION",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos",
                "{{pedidoId}}",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EN_PREPARACION\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Cambió el estado\", () => pm.expect(pm.response.json().estado).to.eql(\"EN_PREPARACION\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Saltar directo a PAGADO (no permitido)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos",
                "{{pedidoId}}",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"PAGADO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Explica por qué\", () => pm.expect(pm.response.json().errores[0]).to.include(\"No se puede pasar de EN_PREPARACION a PAGADO\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pedido con plato inexistente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesa\": 2,\n  \"platos\": {\n    \"999\": 1\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Reservas y caja",
      "item": [
        {
          "name": "Crear reserva válida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Laura Gómez\",\n  \"telefono\": \"3155551212\",\n  \"fecha\": \"{{fechaReserva}}\",\n  \"hora\": \"19:30:00\",\n  \"personas\": 4\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Guarda los datos enviados\", () => { const r = pm.response.json(); pm.expect(r.personas).to.eql(4); pm.expect(r.fecha).to.eql(pm.collectionVariables.get(\"fechaReserva\")); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const f = new Date(); f.setDate(f.getDate() + 7);",
                  "pm.collectionVariables.set(\"fechaReserva\", f.toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reserva fuera de horario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Andrés Pineda\",\n  \"telefono\": \"3009876543\",\n  \"fecha\": \"{{fechaReserva}}\",\n  \"hora\": \"23:00:00\",\n  \"personas\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Mensaje del horario\", () => pm.expect(pm.response.json().errores[0]).to.eql(\"El horario de reservas es de 12:00 a 22:00\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cierre de caja del día",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/caja/cierre?fecha={{hoy}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "caja",
                "cierre"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "{{hoy}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae total de ventas numérico\", () => pm.expect(pm.response.json().totalVentas).to.be.a(\"number\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"hoy\", new Date().toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}